# auto = fixtures only when BOTH project ID and dataset are absent.
# fixture = explicit local fixtures; sanity = require full CMS configuration.
CONTENT_MODE=auto
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
# Sanity Viewer token. Server-side only. Required to enable authenticated draft preview.
SANITY_API_READ_TOKEN=
# Sanity Editor token. Only used by npm run import:content, never by the frontend.
SANITY_API_WRITE_TOKEN=
# GitHub Pages Studio previews use your local authenticated Next.js server.
NEXT_PUBLIC_SANITY_PREVIEW_ORIGIN=http://127.0.0.1:3000
